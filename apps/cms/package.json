{
  "name": "@jskla/cms",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm with-env  PAYLOAD_CONFIG_PATH=src/payload.config.ts nodemon --exec tsx src/server.ts",
    "build": "payload build && tsc",
    "start": "pnpm with-env  node dist/server.js",
    "generate:types": "payload generate:types",
    "check-types": "tsc --noEmit",
    "migrate": "pnpm with-env payload migrate",
    "migrate:create": "pnpm with-env payload migrate:create",
    "postinstall": "pnpm generate:types",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@jskla/config": "workspace:*",
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "@payloadcms/storage-s3": "^3.0.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "express": "^4.21.0",
    "payload": "^3.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@jskla/typescript-config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.3",
    "nodemon": "^3.1.0",
    "tsx": "^4.19.0",
    "typescript": "5.9.2"
  }
}
